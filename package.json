    "audit:icons": "node scripts/audit-offer-icons.mjs",
    "audit:icons:apply": "node scripts/apply-icon-audit-fixes.mjs",
    "monitor:status": "node scripts/write-source-status.mjs",
    "test:logos": "node scripts/test-store-logos-playwright.mjs",
    "test:expiry-ui": "node scripts/test-offer-expiry-playwright.mjs",
    "test:archive-ui": "node scripts/test-offer-archive-playwright.mjs",
    "test:ui": "node scripts/test-offer-expiry-playwright.mjs && node scripts/test-offer-archive-playwright.mjs && node scripts/test-store-logos-playwright.mjs && node scripts/test-terms-playwright.mjs && node scripts/test-catalog-push-invite-playwright.mjs && node scripts/test-mobile-categories-playwright.mjs && node scripts/test-login-oauth-playwright.mjs && node scripts/test-sidebar-profile-playwright.mjs && node scripts/test-christmas-theme-playwright.mjs",
    "telegram:setup": "node scripts/set-telegram-bot.mjs",
    "pr:create": "node scripts/create-pr.mjs"
