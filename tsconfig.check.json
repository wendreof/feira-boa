{
  "extends": "./tsconfig.json",
  "compilerOptions": { "allowJs": true, "checkJs": true, "noEmit": true, "strict": false, "skipLibCheck": true, "lib": ["ES2024", "DOM"] },
  "include": [
    "src/shared/**/*.mjs",
    "scripts/domain/**/*.mjs",
    "scripts/alerts/**/*.mjs",
    "scripts/feed/assemble-feed.mjs",
    "scripts/feed/validate-feed.mjs",
    "scripts/onesignal-client.mjs",
    "src/offer-display.mjs",
    "src/catalog-taxonomy.mjs",
    "scripts/offer-name-guard.mjs",
    "scripts/offer-sector-guard.mjs"
  ],
  "exclude": ["node_modules"]
}