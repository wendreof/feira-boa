    "pdf-parse": "^2.4.5",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "supabase": "^3.2.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  }
}
