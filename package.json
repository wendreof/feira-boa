{
  "name": "feira-boa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-offer-feed.mjs && node scripts/build-structured-data.mjs && node scripts/inject-site-version.mjs && node scripts/build-bundles.mjs && node scripts/stage-site-html.mjs && node scripts/verify-root-artifacts.mjs",
    "release:tag": "node scripts/git-tag-release.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:coverage": "c8 --check-coverage --reporter=lcov --reporter=text --report-dir=coverage node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "verify:artifacts": "node scripts/verify-root-artifacts.mjs",
    "build:social-card": "node scripts/build-social-card.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "export:christmas-icons": "node scripts/export-christmas-icons-from-reference.mjs",
    "ingest:offers": "node scripts/ingest-offers.mjs",
    "agent:ingest": "node scripts/agent-ingest.mjs",
    "check:site": "node scripts/check-site-health.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:develop": "node scripts/sync-develop-from-main.mjs",
    "send:price-alerts": "node scripts/send-price-alerts.mjs",
    "send:price-alerts:dry": "node scripts/send-price-alerts.mjs --dry-run",
    "send:catalog-push": "node scripts/send-catalog-push.mjs",
    "send:catalog-push:dry": "node scripts/send-catalog-push.mjs --dry-run",
    "review:source": "node scripts/review-source.mjs",
    "monitor:sources": "node scripts/monitor-sources.mjs",
